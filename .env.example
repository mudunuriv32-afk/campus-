# ==============================================================================
# CampusConnect: Environment Variables Configuration Guide
# ==============================================================================
# Use this file as a reference when configuring your environment locally or in
# production cloud hosting platforms such as Render, Railway, Heroku, or AWS.
#
# FOR RENDER DEPLOYMENT:
# In your Render Dashboard -> Your Web Service -> Environment -> Environment Variables,
# add the Key-Value pairs specified in the PRODUCTION section below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'production' on Render; set to 'development' on your local computer.
FLASK_CONFIG=production

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC SECRET KEY
# ------------------------------------------------------------------------------
# Used for cryptographically signing sessions, CSRF tokens, and security hashes.
# Never share this key or commit it directly to public repositories.
# Generated high-entropy 256-bit key ready for production paste:
SECRET_KEY=d10b4b7564b5f3bffd858fdd6db43b48a0425e1242ba446a8094b97b89102e29

# ------------------------------------------------------------------------------
# 3. DATABASE CONNECTION (DATABASE_URL)
# ------------------------------------------------------------------------------
# WHAT TO PASTE IN RENDER:
# 1. Create a "PostgreSQL" database service in your Render dashboard (e.g. named 'campusconnect-db').
# 2. Under the database service details, find "Connections".
# 3. Copy the "Internal Database URL" (recommended for same-region services) or "External Database URL".
#
# EXAMPLE FORMAT (Copy your actual internal URL from Render):
DATABASE_URL=postgresql://campusconnect_db_user:YOUR_PASSWORD_HERE@dpg-xxxx-a.oregon-postgres.render.com/campusconnect_db

# (For local development only, use SQLite):
# DATABASE_URL=sqlite:///instance/campusconnect.db

# ------------------------------------------------------------------------------
# 4. COOKIE & SESSION SECURITY
# ------------------------------------------------------------------------------
# On Render (HTTPS enabled), set to True. On local localhost (HTTP), set to False.
SESSION_COOKIE_SECURE=True

# ------------------------------------------------------------------------------
# 5. HIGH-CONCURRENCY WORKER & THREAD TUNING (4,000+ MEMBERS)
# ------------------------------------------------------------------------------
# Optimized for Gunicorn multi-threaded asynchronous connection handling.
GUNICORN_WORKER_CLASS=gthread
GUNICORN_THREADS=4
WEB_CONCURRENCY=2
GUNICORN_WORKER_CONNECTIONS=1000
GUNICORN_TIMEOUT=60

# ------------------------------------------------------------------------------
# 6. DATABASE CONNECTION POOLING
# ------------------------------------------------------------------------------
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=50
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# 7. FILE UPLOADS
# ------------------------------------------------------------------------------
# Maximum upload size in bytes (5MB = 5242880 bytes)
MAX_CONTENT_LENGTH=5242880
UPLOAD_FOLDER=app/static/uploads

# ------------------------------------------------------------------------------
# 8. CLOUDINARY CLOUD STORAGE (Optional — For Permanent Cloud Images on Render)
# ------------------------------------------------------------------------------
# If set, uploaded item images and student avatars are automatically uploaded to
# Cloudinary CDN instead of Render's local ephemeral filesystem.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ------------------------------------------------------------------------------
# 9. OPTIONAL SMTP EMAIL DISPATCH (Optional)
# ------------------------------------------------------------------------------
# If you want automated email alerts on password reset or claim approval:
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-campus-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=notifications@campusconnect.edu
